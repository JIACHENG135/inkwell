[Unit]
Description=goMarkableStream (screenshot/login API used by rm-agent)
After=xochitl.service
# Requires= is deliberate here, unlike in rm-agent-paperpro.service: this
# process locates the framebuffer by scanning xochitl's memory, so its pointer
# dies with xochitl and it has to go down and come back with it.
Requires=xochitl.service
# It loses the race with xochitl at boot and exits ("failed to calculate frame
# pointer"). Restarting until it wins is the intended recovery, so the default
# start-rate limit must not be allowed to end that early.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/root
Environment=HOME=/home/root
Environment=USER=root
Environment=LANG=en_US.UTF-8
# Give xochitl a moment to allocate the framebuffer before scanning for it.
ExecStartPre=/bin/sleep 5
ExecStart=/home/root/goMarkableStream
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
